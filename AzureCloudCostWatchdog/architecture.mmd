    style VM2 fill:#99FF99,stroke:#333,stroke-width:2px
    style VM3 fill:#FFFF99,stroke:#333,stroke-width:2px
    style VM4 fill:#CCCCCC,stroke:#333,stroke-width:2px
    
    style FUNCTION_APP fill:#E6E6FA,stroke:#333,stroke-width:2px
    style STORAGE fill:#FFE4B5,stroke:#333,stroke-width:2px
    style CONTAINER fill:#FFE4B5,stroke:#333,stroke-width:2px
    
    style SCANNER fill:#87CEEB,stroke:#333,stroke-width:2px
    style SCHEDULER fill:#87CEEB,stroke:#333,stroke-width:2px
    style VM_MONITOR fill:#87CEEB,stroke:#333,stroke-width:2px
    style NOTIFICATION fill:#87CEEB,stroke:#333,stroke-width:2px
    style LOGGER fill:#87CEEB,stroke:#333,stroke-width:2px
    
    style TIMER fill:#FFB6C1,stroke:#333,stroke-width:2px
    
    style TEAMS fill:#FF69B4,stroke:#333,stroke-width:2px
    style SLACK fill:#808080,stroke:#333,stroke-width:2px
    style EMAIL fill:#4169E1,stroke:#333,stroke-width:2px
