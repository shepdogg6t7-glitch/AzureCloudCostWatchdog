        DATA_EXCHANGE[Data Exchange
                      Layer]
        
        %% External Connections
        INTEGRATION_1 --> DATA_EXCHANGE
        INTEGRATION_2 --> DATA_EXCHANGE
        DATA_EXCHANGE --> MONITORING
    end
    
