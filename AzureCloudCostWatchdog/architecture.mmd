graph TD
    %% Main Components
    subgraph "Azure Resources"
        %% Compute Resources
        VM[Virtual Machines]
        VM1[VM-Prod]
        VM2[VM-Dev]
        VM3[VM-Staging]
        VM4[VM-Untagged]
        
        %% Azure Services
        RG[Resource Groups]
        TAG[Tag Services]
        FUNCTION_APP[Azure Function App]
        MONITOR[Monitoring]
        STORAGE[Storage Account]
        CONTAINER[Container for Logs]
        
        %% Connections
        VM1 -. "Environment: Production" .-> FUNCTION_APP
        VM2 -. "Environment: Dev" .-> FUNCTION_APP
        VM3 -. "Environment: Staging" .-> FUNCTION_APP
        VM4 -. "No Tags" .-> FUNCTION_APP
    end
    
    subgraph "Cost Watchdog Application"
        %% Application Components
        SCANNER[VM Scanner]
        SCHEDULER[VM Scheduler]
        VM_MONITOR[VM Monitor]
        NOTIFICATION[Notification System]
        LOGGER[Logging System]
        
        %% Application Flow
        SCANNER --> SCHEDULER
        SCHEDULER --> VM_MONITOR
        VM_MONITOR --> NOTIFICATION
        VM_MONITOR --> LOGGER
        NOTIFICATION -. "Teams/Slack/Webhook" .-> RG
        LOGGER -. "Logs Storage" .-> STORAGE
        STORAGE -. "Access Logging" .-> MONITOR
    end
    
    subgraph "Execution Flow"
        %% Scheduled Execution
        TIMER[Timer Trigger
              every 24h]
        TIMER --> SCANNER
        
        %% Decision Logic
        VM1 -. "Production" .-> SCANNER
        VM2 -. "Dev" .-> SCANNER
        VM3 -. "Staging" .-> SCANNER
        VM4 -. "Untagged" .-> SCANNER
        
        %% Actions
        VM2 --> VM_MONITOR
        VM2 --> "Execute Shutdown"
        VM4 --> VM_MONITOR
        VM4 --> "Execute Shutdown"
        VM1 --> SCANNER
        VM1 --> "Log Only"
        VM3 --> SCANNER
        VM3 --> "Log Only"
    end
    
    subgraph "Notification System"
        %% Notification Channels
        TEAMS[Microsoft Teams]
        SLACK[Slack Webhook]
        EMAIL[Email via Logic App]
        WEBHOOK[Generic Webhook]
        
        %% Notification Flow
        SCANNER --> TEAMS
        SCANNER --> SLACK
        SCANNER --> EMAIL
        SCANNER --> WEBHOOK
    end
    
    subgraph "Monitoring & Alerting"
        %% Monitoring Components
        APP_INSIGHTS[Azure Application Insights]
        LOG_ANALYTICS[Log Analytics]
        METRICS[Metrics]
        ALERTS[Alerts]
        
        %% Alert Flow
        ALERTS -. "Cost Alert" .-> ALERTS
        ALERTS -. "VM Shutdown Alert" .-> ALERTS
        ALERTS -. "Error Alert" .-> ALERTS
    end
    
