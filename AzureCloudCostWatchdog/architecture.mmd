        AUTH --> RBAC
        AUTH --> ENCRYPTION
        AUTH --> MONITORING
        
        COMPLIANCE --> MONITORING
        AUDIT --> MONITORING
        BACKUP --> MONITORING
    end
    
    subgraph "Scalability & High Availability"
