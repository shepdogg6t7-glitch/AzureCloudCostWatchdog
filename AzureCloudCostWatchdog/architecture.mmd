    style LOG_ANALYTICS fill:#8B4513,stroke:#333,stroke-width:2px
    style METRICS fill:#2E8B57,stroke:#333,stroke-width:2px
    style ALERTS fill:#CD5C5C,stroke:#333,stroke-width:2px
    
    %% Data Flow Annotations
    subgraph "Data Flow"
        %% Input Data
        subgraph "Inputs"
            DATA_TAGS[VM Tags Data]
            DATA_CONFIG[Configuration Data]
            DATA_METRICS[Metrics Data]
        end
        
        subgraph "Processing"
            PROC_SCAN[Scan Process]
            PROC_FILTER[Filter Process]
            PROC_DECIDED[Decision Process]
        end
        
        subgraph "Outputs"
            OUTPUT_REPORT[Summary Report]
            OUTPUT_ALERT[Alerts]
            OUTPUT_LOGS[Logs]
        end
        
        DATA_TAGS --> PROC_SCAN
        DATA_CONFIG --> PROC_FILTER
        DATA_METRICS --> PROC_DECIDED
        
        PROC_SCAN --> OUTPUT_REPORT
        PROC_FILTER --> OUTPUT_ALERT
        PROC_DECIDED --> OUTPUT_LOGS
    end
    
    %% Security Components
    subgraph "Security & Compliance"
        ## Security Components
        AUTH[Azure AD Auth]
        RBAC[Role-Based Access]
        ENCRYPTION[Encryption]
        MONITORING[Compliance Monitoring]
        
        ## Compliance Elements
        COMPLIANCE[Compliance
                   Reporting]
        AUDIT[Audit Logs]
        BACKUP[Data Backup]
        
